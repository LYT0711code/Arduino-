
int ledPin = 9;   
int ligPin = A0;   

int set = 15; 

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600); 
}

void loop() {
  
  int sensornum = analogRead(ligPin);
  
  Serial.println(sensornum);
  
  if (sensornum > set) {
    digitalWrite(ledPin, HIGH); 
  } else {
    digitalWrite(ledPin, LOW);  
  }
  
  
}
