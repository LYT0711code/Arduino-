Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);
#define NUMFLAKES     10 // Number of snowflakes in the animation example
#define LOGO_HEIGHT   16
#define LOGO_WIDTH    16
#define ARR_MOVS 16
static const unsigned char PROGMEM logo_bmp[] =
{ B00000000, B11000000,
  B00000001, B11000000,
  B00000001, B11000000,
  B00000011, B11100000,
  B11110011, B11100000,
  B11111110, B11111000,
  B01111110, B11111111,
  B00110011, B10011111,
  B00011111, B11111100,
  B00001101, B01110000,
  B00011011, B10100000,
  B00111111, B11100000,
  B00111111, B11110000,
  B01111100, B11110000,
  B01110000, B01110000,
  B00000000, B00110000 };


  unsigned char dino [] = {
  0x7C, 0x44, 0xC7, 0x81, 0xA9, 0x81, 0xBB, 0x82, 0x7E, 0x24, 0x24, 0x24, 0x24, 0x24, 0x24, 0x66
  } ;
  unsigned char cactus [] = {
  0x3C, 0x3C, 0xFF, 0xFF, 0xFF, 0xFF, 0x3C, 0x3C, 0x3C, 0x3C, 0x3C, 0x3C, 0x3C, 0x3C, 0x3C, 
  };
  unsigned char cactus1 [] = {
  0x18, 0xF8, 0x1B, 0x1E, 0x18, 0x78, 0xDF, 0x18, 
  };
unsigned long time_info=0; 
unsigned long time_ms_tmp=0;
unsigned long time_ms_n;
int s=2;
int m=0;
int mode=0;
bool f_start;
bool fillRect1;  
bool fillRect2=true;
bool fillRect3;  
bool fillRect4=true;
int movs[ARR_MOVS]={0,1,3,6,10,12,12,12,12,12,12,10,6,3,1,0};
bool L_btn ,M_btn ,R_btn;
bool L_btn_Prev ,M_btn_Prev ,R_btn_Prev;
int a=128;
int b=128;
int c=15;
bool y; 
bool j;
int ij;
int dino_x=10;
int dino_w=8;
int dino_y=15;
int dino_h=16;
int cactus_w=8;
int cactus_x=a;
int cactus_h=16;
int cactus_y=15;
int cactus1_x=b;
int cactus1_w=8;
int cactus1_h=8;
int cactus1_y=23;
int fram=0;  
int score=0;
void setup() {
 pinMode(3,OUTPUT);
 pinMode(2,OUTPUT);
 pinMode(10,OUTPUT);
 digitalWrite(2,HIGH);
 Serial.begin(9600);
  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { // Address 0x3C for 128x32
    Serial.println(F("SSD1306 allocation failed"));
    for(;;); // Don't proceed, loop forever
    // Show initial display buffer contents on the screen --
  // the library initializes this with an Adafruit splash screen.
  display.display();
  delay(2000); // Pause for 2 seconds
  } 
  
}
void loop() {
   R_btn=digitalRead(A0);
   M_btn=digitalRead(A1);
   L_btn=digitalRead(A2);
   
  
   if(M_btn)
   {
      if(mode==0)
      {  
         fillRect1=true;
         fillRect2=false;
      }
      else if(mode==2)
      {
         fillRect4=true;
         fillRect3=false;
      }
      else if(mode==1||mode==3)
      {
          mode=0;  
          time_info=0;
      }
     
      else if(f_start)
      {
        mode=0;
        s=2;
      }
      else
      {}
      
        
      
   }
   if(L_btn)
   {
      if(mode==0&&fillRect1)
      {
          mode=2;
      }
      
      else if(mode==0&&fillRect2)
      {
          mode=1;
      }
      
      else if(mode==2&&fillRect3)
      {   
          mode=3;
      }
      
      else if(mode==2&&fillRect4)
      {
          mode=4;
      }
      else if(mode==4)
      {  
         f_start=true;
         R_btn=false;
      }
      else
      {}
      
   }
   if(R_btn)
   {
      if(mode==0)
      {  
          fillRect2=true;
          fillRect1=false;
      }
      else if(mode==2)
      {
          fillRect3=true;
          fillRect4=false;
      }
      else if(mode==1)
      {
          j=true;
          if(ij<5)
          ij++;
      }
      else if(mode==4)
      {
        if(R_btn ^ R_btn_Prev && R_btn)
        {
         s+=1;
         
        } 
        
      }   
      else
      {}
   }
   
   if(mode==0)
   {
     display.clearDisplay();
     display.setTextSize(2);             
     display.setTextColor(SSD1306_WHITE);           
     display.setCursor(3,1);             
     display.println("-dino");   
     display.setCursor(3,17);             
     display.println("-time");
     if(fillRect1)
     {
        fillRect2=false;
        display.fillRect(3,17 ,60 ,31 , SSD1306_INVERSE);
     }
     if(fillRect2)
     {
        fillRect1=false;
        display.fillRect(3,1 ,60 ,15 , SSD1306_INVERSE); 
     }
     display.display();
   }
    else if(mode==1)//dino
    {
        if(j)
        { 
          fram+=1;
          if(fram>=ARR_MOVS)
          { 
            fram=0;
            j=false;
            ij=0;
          }   
        }
        
          if(cactus_x<=128)
          { 
            cactus_x-=3;
          }
          if(cactus_x<=0)
          {
            cactus_x=128;
          }
          if(cactus1_x<=128)
          { 
            cactus1_x-=2; 
          } 
          if(cactus1_x<=0)
          {
            cactus1_x=128;
          }
          
        dino_y = c-(movs[fram]*ij);
 
        if ( ( ((dino_x+dino_w)>cactus1_x) && (dino_x<=(cactus1_x+cactus1_w)) )  &&
            ((dino_y+dino_h)>=cactus1_y) ||  
            ( ((dino_x+dino_w)>=cactus_x) && (dino_x<=(cactus_x+cactus_w)) )  &&
            ((dino_y+dino_h)>=cactus_y) )
        {
          display.clearDisplay();
          display.setTextSize(2);             
          display.setTextColor(SSD1306_WHITE);           
          display.setCursor(5,13);             
          display.println("Game over!");
          display.display();
          delay(2000);
          dino_x=10;
          dino_y=15;
          cactus1_x=128;
          cactus1_y=23;
          cactus_x=128;
          cactus_y=15;
          fram=0;  
          score=0;
          ij=0;
        }
          
          display.clearDisplay();
          display.drawLine(0,31 ,128 , 31, SSD1306_WHITE);
          display.drawBitmap(10,c-(movs[fram]*ij),dino,8,16,1);
          display.drawBitmap(cactus_x,15,cactus,8,16,1);
          display.drawBitmap(cactus1_x,23,cactus1,8,8,1);
          display.setTextSize(1);             
          display.setTextColor(SSD1306_WHITE);           
          display.setCursor(100,1); 
          display.println(score);  
          score++;          
          
         
          L_btn_Prev= L_btn;
          M_btn_Prev= M_btn;
          R_btn_Prev= R_btn;
          delay(70);
          display.setTextSize(0.3);             
          display.setTextColor(SSD1306_WHITE);           
          display.setCursor(25,1);             
          display.println("M_btn-quit");  
          display.display();
    }
   
   else if(mode==2)
   {  
     
     display.clearDisplay();
     display.setTextSize(2);             
     display.setTextColor(SSD1306_WHITE);           
     display.setCursor(3,1);             
     display.println("-timing");   
     display.setCursor(3,17);             
     
     if(fillRect3)
     {
        fillRect4=false;
        display.fillRect(2,1 ,84 ,16 , SSD1306_INVERSE); 
     }
     if(fillRect4)
     {
        fillRect3=false;
        display.fillRect(3,17 ,72 ,31 , SSD1306_INVERSE);
     }
     display.display();
   }
   else if(mode==3)//timing
   {
      display.clearDisplay();
      time_info=millis();
          
      display.clearDisplay();
      display.setTextSize(3);
      display.setCursor(3,11);             
      display.setTextColor(SSD1306_WHITE);
      display.print(time_info/1000);
      
      display.setTextSize(0.3);             
      display.setTextColor(SSD1306_WHITE);           
      display.setCursor(60,1);     
      display.println("M_btn-quit");    
      display.display();
   }  
   else if(mode==4)
   {
      
      time_ms_tmp=millis();
      
      
      display.clearDisplay();
      display.setTextSize(2);             
      display.setTextColor(SSD1306_WHITE);           
      display.setCursor(2,13);             
      display.print(m);
      display.setTextSize(2);             
      display.setTextColor(SSD1306_WHITE);           
      display.setCursor(50,13);             
      display.println(":");
      display.setTextSize(2);             
      display.setTextColor(SSD1306_WHITE);           
      display.setCursor(90,13);             
      display.print(s);
      display.display();
 
   if(f_start)
   {
        
        if(time_ms_tmp-time_ms_n>=1000)
        {
            s-=1;
            time_ms_n=time_ms_tmp;
        }
        if(s==0&&m==0)
        { 
            digitalWrite(3,HIGH);
            delay(1000);
            digitalWrite(3,LOW);
            digitalWrite(10,HIGH);
            delay(50);
            digitalWrite(10,LOW);
            delay(50);
            digitalWrite(10,HIGH);
            delay(50);
            digitalWrite(10,LOW);
            s=2;
            f_start=false;
            mode=0;
       } 
        L_btn_Prev= L_btn;
        M_btn_Prev= M_btn;
        R_btn_Prev= R_btn;
    }
   
      
      
      
   }

   else
   {}
  
}
void testdrawline() {
  int16_t i;

  display.clearDisplay(); // Clear display buffer

  for(i=0; i<display.width(); i+=4) {
    display.drawLine(0, 0, i, display.height()-1, SSD1306_WHITE);
    display.display(); // Update screen with each newly-drawn line
    delay(1);
  }
  for(i=0; i<display.height(); i+=4) {
    display.drawLine(0, 0, display.width()-1, i, SSD1306_WHITE);
    display.display();
    delay(1);
  }
  delay(250);

  display.clearDisplay();

  for(i=0; i<display.width(); i+=4) {
    display.drawLine(0, display.height()-1, i, 0, SSD1306_WHITE);
    display.display();
    delay(1);
  }
  for(i=display.height()-1; i>=0; i-=4) {
    display.drawLine(0, display.height()-1, display.width()-1, i, SSD1306_WHITE);
    display.display();
    delay(1);
  }
  delay(250);

  display.clearDisplay();

  for(i=display.width()-1; i>=0; i-=4) {
    display.drawLine(display.width()-1, display.height()-1, i, 0, SSD1306_WHITE);
    display.display();
    delay(1);
  }
  for(i=display.height()-1; i>=0; i-=4) {
    display.drawLine(display.width()-1, display.height()-1, 0, i, SSD1306_WHITE);
    display.display();
    delay(1);
  }
  delay(250);

  display.clearDisplay();

  for(i=0; i<display.height(); i+=4) {
    display.drawLine(display.width()-1, 0, 0, i, SSD1306_WHITE);
    display.display();
    delay(1);
  }
  for(i=0; i<display.width(); i+=4) {
    display.drawLine(display.width()-1, 0, i, display.height()-1, SSD1306_WHITE);
    display.display();
    delay(1);
  }

  delay(2000); // Pause for 2 seconds
}

